# Telegram bot token — get this from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# Attribution tag from the Celo Agents at Work Hackathon registration.
# This must be wired into every real transaction — no backfill.
HACKATHON_ATTRIBUTION_TAG=celo_291c76e9ecab

# Master key used to deterministically derive per-user wallets for this
# hackathon build. DEMO-GRADE ONLY — see WALLET SECURITY note in
# src/wallet.mjs before using this approach with real user funds.
WALLET_MASTER_SEED=

# VTpass — the Nigerian bills aggregator Sendo uses to actually deliver
# airtime. Sign up at vtpass.com (sandbox: sandbox.vtpass.com) to get
# these. VTPASS_MODE controls which base URL is used.
VTPASS_USERNAME=
VTPASS_PASSWORD=
VTPASS_MODE=sandbox
